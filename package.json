{
  "name": "arrows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm test && npm run build",
    "android:sync": "npm run build && node tools/prepare-native.mjs && cap sync android",
    "android:open": "cap open android",
    "content:controls": "vite build --ssr tools/content/control-scene-source.ts --outDir .test-output/control-source && node tools/content/write-control-scenes.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@danilah/mini-games-kit": "github:DanilaH/mini-games-kit#a9325265e87583a4872cf6a158e1e881a0d7508e",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.56.1",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
